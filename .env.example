# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# Optional: your server's ID. Commands register instantly to this guild (great for dev).
# Leave empty for global commands (can take up to an hour to show up).
GUILD_ID=
# SQLite file location. docker-compose overrides this to /data/bot.db.
DB_PATH=data/bot.db
# Folder with history.md, charter.md and ships.json (edit them any time, no restart needed).
CONTENT_DIR=content
# Ship data for /ship comes from the Star Citizen Wiki API (credited in the embed).
# Set to "off" to use only content/ships.json. Leave empty for the default.
SHIP_API_URL=
